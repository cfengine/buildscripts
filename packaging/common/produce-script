#!/bin/sh

# Produces a package script by concatenating snippets according to the following
# rules:
#
# type = <deb|rpm|depot|bff|pkg>
# action = <install|remove>
#
# script-header.sh (required)
# <type>-script-common.sh (required)
# note: generated from <type>-script-common.sh.in by build-scripts/package
# <type>-script-common-<action>.sh
# script-common.sh (required)
# script-common-<action>.sh
# script-common-header-last.sh (required)
# ../cfengine-PROJECT[-hub]/<pre|post><install|remove>.sh
#
# A missing required script is an error. Any other missing script is skipped.

if [ $# -ne 3 ]; then
  echo "Usage: $0 cfengine-PROJECT[-hub] <pre|post><install|remove> pkg-type"
  exit 1
fi

SCRIPTDIR="`dirname $0`"
TEMPLATEDIR="$SCRIPTDIR/script-templates"
PROJECT_TYPE="$1"
SCRIPT_TYPE="$2"
PKG_TYPE="$3"

include_script()
{
  if [ -f "$1" ]; then
    cat "$1"
  fi
}

# Like include_script, but fails if the file is missing
require_script()
{
  if [ ! -f "$1" ]; then
    echo "$0: error: required script $1 not found" >&2
    exit 1
  fi
  cat "$1"
}

require_script "$TEMPLATEDIR/script-header.sh"
require_script "$TEMPLATEDIR/$PKG_TYPE-script-common.sh"

case "$PKG_TYPE" in
    deb|rpm)
      echo "set -e"
      ;;
esac

echo "PKG_TYPE=$PKG_TYPE"
echo "SCRIPT_TYPE=$SCRIPT_TYPE"
echo "PROJECT_TYPE=$PROJECT_TYPE"
echo "BUILT_ON_OS=$OS"
BUILT_ON_OS_VERSION="`expr "$OS_VERSION" : "\([0-9]*\)"`"
echo "BUILT_ON_OS_VERSION=$BUILT_ON_OS_VERSION"

# Shipped LMDB version, compared against the installed one by
# lmdb_migration_needed() (CFE-4701). The source file lists one mirror URL per
# line, so the version is taken from the first.
LMDB_VERSION="$(sed -n -e 's,/$,,' -e 's,.*/LMDB_,,' -e '1p' "$SCRIPTDIR/../../deps-packaging/lmdb/source" 2>/dev/null)"
echo "LMDB_VERSION=$LMDB_VERSION"

case "$SCRIPT_TYPE" in
  *install)
    include_script "$TEMPLATEDIR/$PKG_TYPE-script-common-install.sh"
    require_script "$TEMPLATEDIR/script-common.sh"
    include_script "$TEMPLATEDIR/script-common-install.sh"
    include_script "$TEMPLATEDIR/script-common-$SCRIPT_TYPE.sh"
    ;;
  *remove)
    include_script "$TEMPLATEDIR/$PKG_TYPE-script-common-remove.sh"
    require_script "$TEMPLATEDIR/script-common.sh"
    include_script "$TEMPLATEDIR/script-common-remove.sh"
    include_script "$TEMPLATEDIR/script-common-$SCRIPT_TYPE.sh"
    ;;
esac

require_script "$TEMPLATEDIR/script-common-header-last.sh"

# Not having a script is not an error. Not all scripts are used,
# and not all projects are ported over.
case "$PROJECT_TYPE" in
  cfengine-nova-hub)
    include_script "$SCRIPTDIR/cfengine-hub/$SCRIPT_TYPE.sh"
    ;;
  *)
    include_script "$SCRIPTDIR/cfengine-non-hub/$SCRIPT_TYPE.sh"
    ;;
esac
